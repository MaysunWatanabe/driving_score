<?xml version="1.0" encoding="utf-8"?>
<!--
  ヒヤリ表示ウィジェット 2-1a のレイアウト（fact #4765 / proposal #306 / #307）

  左にアイコン、右に情報を置く横並び。背景は白固定で、状態はアイコンと
  文字色で表す。

  右カラムは 日付 → ラベル → 件数 の順（proposal #307）。上から
  「2026/9/30 の / 今日のヒヤリ / 4 件」と素直に読める並びにする。

  1 行目は「この件数が対象とする日」で、描画時点の端末ローカル日付を
  常に出す（proposal #306）。最終更新時刻を出して本日以外は隠す方式
  （fact #4767）は撤回した。どの状態でも 3 行で一定になる。

  表示値は HiyariWidgetProvider が実行時に流し込む。ここで固定文字列を
  持つのはラベルだけ（常に「今日のヒヤリ」）。

  RemoteViews は TextView / ImageView / LinearLayout 等しか扱えない。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_hiyari_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_hiyari_background">

    <ImageView
        android:id="@+id/widget_hiyari_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:layout_marginRight="14dp"
        android:contentDescription="@string/widget_hiyari_title"
        android:src="@drawable/widget_hiyari_icon_ok" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_hiyari_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#666666"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_hiyari_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_hiyari_title"
            android:textColor="#1A1A1A"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_hiyari_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="#2E7D32"
            android:textSize="32sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
