// dev 用シークレットのテンプレート。
//   1) このファイルを `environment.secrets.ts` にコピー
//   2) mapsKey に自身の Google Maps API key (dev 用) を書き込む
//   3) `environment.secrets.ts` は .gitignore 済み。commit されないこと
//
// prod 用は `environment.prod.secrets.ts` を別途配置する。
export const secrets = {
  mapsKey: 'REPLACE_WITH_YOUR_DEV_GOOGLE_MAPS_KEY',
};
