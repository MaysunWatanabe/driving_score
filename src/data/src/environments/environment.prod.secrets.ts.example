// prod 用シークレットのテンプレート。
//   1) このファイルを `environment.prod.secrets.ts` にコピー
//   2) mapsKey に本番用 Google Maps API key を書き込む
//   3) `environment.prod.secrets.ts` は .gitignore 済み。CI では通常
//      secrets manager から動的に書き出す運用にする。
export const secrets = {
  mapsKey: 'REPLACE_WITH_YOUR_PROD_GOOGLE_MAPS_KEY',
};
